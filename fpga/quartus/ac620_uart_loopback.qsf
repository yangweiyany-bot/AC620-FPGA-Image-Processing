
# ============================================================
# AC620 FPGA Image Processing Project
# Quartus II 13.0
# Device: Cyclone IV E - EP4CE10F17C8
# ============================================================

# Device settings
set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8
set_global_assignment -name TOP_LEVEL_ENTITY ac620_uart_loopback_top

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V

set_global_assignment -name LAST_QUARTUS_VERSION 13.0

# ============================================================
# RTL Source Files
# ============================================================

set_global_assignment -name VERILOG_FILE ../rtl/ac620_uart_loopback_top.v
set_global_assignment -name VERILOG_FILE ../rtl/uart_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/uart_tx.v
set_global_assignment -name VERILOG_FILE ../rtl/mean_filter_3x3.v
set_global_assignment -name VERILOG_FILE ../rtl/median_filter_3x3.v

# ============================================================
# Timing Constraints
# ============================================================

set_global_assignment -name SDC_FILE ac620_uart_loopback.sdc

# ============================================================
# AC620 V2 Pin Assignments
# ============================================================

# 50 MHz clock
set_location_assignment PIN_E1 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# Reset button S2, active low
set_location_assignment PIN_E16 -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n

# LED0, active low
set_location_assignment PIN_A2 -to led
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led

# UART RX
set_location_assignment PIN_B5 -to uart_rx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx

# UART TX
set_location_assignment PIN_A6 -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx

# ============================================================
# Unused Pins
# ============================================================

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# ============================================================
# ModelSim Simulation Settings
# ============================================================

set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation

set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation

# Default simulation testbench
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_mean_filter_3x3 -section_id eda_simulation

# ============================================================
# UART Testbench
# ============================================================

set_global_assignment -name EDA_TEST_BENCH_NAME tb_uart_loopback -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_uart_loopback -section_id tb_uart_loopback
set_global_assignment -name EDA_TEST_BENCH_FILE ../tb/tb_uart_loopback.v -section_id tb_uart_loopback
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_uart_loopback

# ============================================================
# Mean Filter Testbench
# ============================================================

set_global_assignment -name EDA_TEST_BENCH_NAME tb_mean_filter_3x3 -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_mean_filter_3x3 -section_id tb_mean_filter_3x3
set_global_assignment -name EDA_TEST_BENCH_FILE ../tb/tb_mean_filter_3x3.v -section_id tb_mean_filter_3x3
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_mean_filter_3x3

# ============================================================
# Median Filter Testbench
# ============================================================

set_global_assignment -name EDA_TEST_BENCH_NAME tb_median_filter_3x3 -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_median_filter_3x3 -section_id tb_median_filter_3x3
set_global_assignment -name EDA_TEST_BENCH_FILE ../tb/tb_median_filter_3x3.v -section_id tb_median_filter_3x3
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_median_filter_3x3

# ============================================================
# Other Quartus Settings
# ============================================================

set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top


set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
